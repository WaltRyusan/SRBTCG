<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- トラッキングを行うか -->
	<!-- AdMob が IDFA を用いた広告配信を行うため true -->
	<key>NSPrivacyTracking</key>
	<true/>

	<!-- トラッキングに使用するドメイン -->
	<!-- ATT で拒否された場合、ここに挙げたドメインへの接続は OS が遮断する。
	     広告関連ドメインは GoogleMobileAds 側の PrivacyInfo.xcprivacy が
	     宣言済みのため、ここでは重複させない。 -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- 収集するデータの種類 -->
	<!-- 収集はすべて Google AdMob SDK 経由であり、アプリ独自の収集・送信はない。
	     内容は AdMob 公式のデータ開示に準拠する。
	     https://developers.google.com/admob/ios/privacy/data-disclosure

	     マイクと音声認識は申告対象外。録音した音声は文字変換にのみ使い、
	     端末が対応していればデバイス内で処理する
	     （STTManager で requiresOnDeviceRecognition = true）。
	     非対応時は iOS 標準機能を通じて Apple が処理するが、
	     これは Apple のサービスであり開発者による収集ではない。
	     音声そのものは変換後に破棄し、端末内に残るのは変換後の文字だけ。 -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- デバイスID（IDFA） -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- 広告データ -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAdvertisingData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
		<!-- 製品インタラクション（広告の表示・タップ等） -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- パフォーマンスデータ -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- クラッシュデータ -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- おおよその位置情報（IPアドレスからの推定） -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<!-- 理由の申告が必要なAPI（Required Reason API） -->
	<!-- 使用しているのは UserDefaults のみ。
	     ファイルのタイムスタンプ・起動時刻・ディスク容量の各APIは使っていない。 -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults: Wave記録・言語設定・購入状態・使用回数の保存に使用。
		     いずれもアプリ自身の動作のためで、アプリ外へのデータ送信は行わない。 -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
